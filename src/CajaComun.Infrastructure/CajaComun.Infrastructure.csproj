<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CajaComun.Application\CajaComun.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Polly.Core" Version="8.*" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.2" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.22.10" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\db\objetos\*.sql" LogicalName="objetos/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\docs\consultas-parte2*.sql" LogicalName="consultas/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CajaComun.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8034</NoWarn>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

