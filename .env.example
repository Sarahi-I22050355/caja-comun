# Copiar a .env y cambiar los valores. El archivo .env no se versiona.
MARIADB_ROOT_PASSWORD=cambiar_root
MARIADB_DATABASE=caja_comun
MARIADB_USER=caja
MARIADB_PASSWORD=cambiar_caja
# Puerto publicado en el host (3306 ya lo usa el MariaDB local de Windows)
MARIADB_PORT=3307

# Puerto donde nginx sirve la aplicación
WEB_PORT=8080
