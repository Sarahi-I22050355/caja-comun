# Copiar a .env. Los valores vacíos de contraseña los genera scripts/up.ps1 (o scripts/up.sh) con valores
# aleatorios; si copias el archivo a mano, escribe tus propias contraseñas. El archivo .env no se versiona.
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=caja_comun
MARIADB_USER=caja
MARIADB_PASSWORD=
# Puerto publicado en el host (3306 ya lo usa el MariaDB local de Windows)
MARIADB_PORT=3307

# Puerto donde nginx sirve la aplicación
WEB_PORT=8080

# Secreto con el que la API firma los tokens de sesión (mínimo 32 caracteres). Si queda vacío,
# scripts/up.ps1 (o up.sh) genera uno aleatorio. Cambiarlo cierra todas las sesiones abiertas.
JWT_SECRET=

# Contraseñas de los usuarios de demostración que crea el seed. Si se dejan vacías, el seed genera
# unas aleatorias y las imprime una sola vez en la consola.
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_CAPTURISTA_GIMSA=
SEED_PASSWORD_CONSULTA_ACEROS=
SEED_PASSWORD_CAPTURISTA_BRAVO=

# Parte 2 (perfil `federation`): contraseñas de los motores de la federación y puerto local de Trino. Si se dejan
# vacías, scripts/federacion.ps1 (o federacion.sh) las genera al levantar la federación.
FEDERACION_MARIADB_PASSWORD=
FEDERACION_POSTGRES_PASSWORD=
FEDERACION_CLICKHOUSE_PASSWORD=
TRINO_PORT=8081
